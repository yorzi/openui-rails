<!doctype html>
<html lang="en">
  <head>
    <title>Support Desk · OpenUI Rails reference</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= openui_stylesheet_tag %>
    <%= javascript_importmap_tags "support_desk" %>
    <style>
      body { margin: 0; padding: 24px; font: 16px/1.6 system-ui; background: #f6f7f9; color: #17202a; }
      main { max-width: 800px; margin: auto; } h1 { font-size: 28px; } button { cursor: pointer; }
      header { display: flex; gap: 16px; align-items: center; flex-wrap: wrap; }
      .notice { padding: 12px; background: #fff3cf; border-radius: 8px; }
      [role="alert"] { color: #a11; } .openui-surface { background: white; padding: 16px; border-radius: 12px; }
    </style>
  </head>
  <body><main><%= yield %></main></body>
</html>
